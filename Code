class RecipeFinder(QWidget):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("Recipe Finder | World Flavors")
        self.resize(1180, 800)
        self.setMinimumSize(900, 600)

        self.api_key = os.getenv("NINJAS_API_KEY", "").strip()
        self.results = RECIPES.copy()
        self.current_recipe = None
        self.favorites = self.load_favorites()

        self.setStyleSheet("""
            QWidget {
                background: #081820;
                color: #edf5f7;
                font-family: Segoe UI;
                font-size: 13px;
            }
            QFrame {
                background: #102630;
                border: 1px solid #2a4b58;
                border-radius: 10px;
            }
            QLabel#title {
                color: #ffb52e;
                font-size: 28px;
                font-weight: bold;
            }
            QLineEdit, QListWidget, QTextBrowser {
                background: #0b1d26;
                border: 1px solid #365766;
                border-radius: 7px;
                padding: 8px;
            }
            QListWidget::item {
                padding: 12px;
                margin: 3px;
                border-radius: 6px;
            }
            QListWidget::item:selected {
                background: #176653;
            }
            QPushButton {
                background: #173440;
                border: none;
                border-radius: 7px;
                padding: 11px;
                font-weight: bold;
            }
            QPushButton:hover {
                background: #205060;
            }
            QPushButton#search {
                background: #ffb52e;
                color: #14212a;
            }
            QPushButton#favorite {
                background: #168067;
            }
        """)

        self.build_ui()
        self.show_recipes(self.results)

    def build_ui(self):
        outer = QVBoxLayout(self)
        outer.setContentsMargins(18, 16, 18, 16)
        outer.setSpacing(12)

        header = QFrame()
        header_layout = QVBoxLayout(header)

        title = QLabel("🍲  Recipe Finder")
        title.setObjectName("title")

        subtitle = QLabel(
            "WORLD FLAVORS  •  AFRICAN FOODS  •  POWERED BY API NINJAS"
        )

        header_layout.addWidget(title)
        header_layout.addWidget(subtitle)
        outer.addWidget(header)

        body = QHBoxLayout()
        body.setSpacing(12)
        outer.addLayout(body, 1)

        # Left navigation
        left = QFrame()
        left.setFixedWidth(205)
        left_layout = QVBoxLayout(left)

        nav_title = QLabel("EXPLORE")
        nav_title.setStyleSheet("color:#ffb52e;font-weight:bold;")
        left_layout.addWidget(nav_title)

        buttons = [
            ("🔎 Search Recipes", self.focus_search),
            ("🎲 Surprise Me", self.surprise_me),
            ("♥ Favorites", self.show_favorites),
            ("🌍 African Foods", self.show_african_foods),
            ("🇳🇬 Nigerian Jollof", self.show_nigerian_jollof),
            ("🇬🇭 Ghanaian Jollof", self.show_ghanaian_jollof),
            ("💾 Save Favorites", self.save_favorites)
        ]

