    def load_favorites(self):
        try:
            with open(FAVORITES_FILE, "r", encoding="utf-8") as file:
                data = json.load(file)
                return data if isinstance(data, list) else []
        except (OSError, json.JSONDecodeError):
            return []

    def save_favorites(self):
        try:
            with open(FAVORITES_FILE, "w", encoding="utf-8") as file:
                json.dump(self.favorites, file, indent=4, ensure_ascii=False)

            self.status_label.setText("Favorites saved successfully!")
        except OSError as error:
            QMessageBox.warning(
                self, "Save Error", f"Could not save favorites:\n{error}"
            )

    def show_recipes(self, recipes):
        self.results = recipes
        self.recipe_list.blockSignals(True)
        self.recipe_list.clear()

        for recipe in recipes:
            self.recipe_list.addItem(recipe.get("title", "Untitled recipe"))

        self.recipe_list.blockSignals(False)
        self.results_label.setText(f"Search Results ({len(recipes)})")

        if recipes:
            self.recipe_list.setCurrentRow(0)
        else:
            self.current_recipe = None
            self.recipe_title.setText("No recipes found")
            self.details.setText(
                "No matching recipes were found.\n\n"
                "Try another search or browse African Foods."
            )

    def select_recipe(self, index):
        if index < 0 or index >= len(self.results):
            return

        recipe = self.results[index]
        self.current_recipe = recipe

        self.recipe_title.setText(recipe.get("title", "Recipe"))

        ingredients = recipe.get("ingredients", [])
        instructions = recipe.get("instructions", [])

        if isinstance(ingredients, str):
            ingredients = [ingredients]
        if isinstance(instructions, str):
            instructions = [instructions]

        html = [
            f"<h3>{recipe.get('title', 'Recipe')}</h3>",
            f"<p><b>Country:</b> {recipe.get('country', 'Not specified')}</p>",
            "<h3>🥕 INGREDIENTS</h3><ul>"
        ]

        for ingredient in ingredients:
            html.append(f"<li>{ingredient}</li>")

        html.append("</ul><h3>👩‍🍳 INSTRUCTIONS</h3><ol>")

        for instruction in instructions:
            html.append(f"<li>{instruction}</li>")

        html.append("</ol>")

        if recipe.get("description"):
            html.insert(
                1, f"<p>{recipe['description']}</p>"
            )

        self.details.setHtml("".join(html))

    def search_recipes(self):
        query = self.search_input.text().strip()

        if not query:
            QMessageBox.information(
                self, "Search", "Please enter a recipe name."
            )
            return

        local_matches = [
            recipe for recipe in RECIPES
            if query.lower() in recipe["title"].lower()
            or query.lower() in recipe["country"].lower()
        ]

        self.status_label.setText(f"Searching for {query}...")

        if not self.api_key:
            self.show_recipes(local_matches)
            self.status_label.setText(
                "Showing built-in matches. Set NINJAS_API_KEY "
                "in your terminal to search online."
            )
            return

        try:
            response = requests.get(
                API_URL,
                headers={"X-Api-Key": self.api_key},
                params={"title": query},
                timeout=20
            )

            if response.status_code in (401, 403):
                raise ValueError(
                    "API key rejected. Check your API Ninjas key."
                )

            if response.status_code == 400:
                raise ValueError(
                    "The API rejected the search. Try a different phrase."
                )

            if response.status_code == 429:
                raise ValueError(
                    "API request limit reached. Try again later."
                )

            response.raise_for_status()
            data = response.json()

            if isinstance(data, dict):
                data = (
                    data.get("recipes")
                    or data.get("results")
                    or data.get("data")
                    or []
                )

            if not isinstance(data, list):
                data = []

            online_matches = []

            for item in data:
                if isinstance(item, dict):
                    recipe = self.normalise_recipe(item)
                    if recipe:
                        online_matches.append(recipe)

            combined = local_matches + online_matches

            # Remove duplicate titles.
            unique = {}
            for recipe in combined:
                unique[recipe["title"].lower()] = recipe

            matches = list(unique.values())
            self.show_recipes(matches)

            self.status_label.setText(
                f"Found {len(matches)} matching recipe(s)."
            )

        except (requests.RequestException, ValueError) as error:
            self.show_recipes(local_matches)
            self.status_label.setText(
                f"Online search failed: {error}. "
                "Showing available built-in matches."
            )

    @staticmethod
    def normalise_recipe(raw):
        title = (
            raw.get("title")
            or raw.get("name")
            or raw.get("recipe")
            or "Online Recipe"
        )

        ingredients = raw.get("ingredients") or []
        instructions = (
            raw.get("instructions")
            or raw.get("directions")
            or []
        )

        if isinstance(ingredients, str):
            ingredients = [
                item.strip()
                for item in ingredients.replace("\n", ",").split(",")
                if item.strip()
            ]

        if isinstance(instructions, str):
            instructions = [
                item.strip()
                for item in instructions.splitlines()
                if item.strip()
            ]

            if len(instructions) <= 1:
                instructions = [
                    step.strip()
                    for step in instructions[0].replace(". ", ".\n").splitlines()
                    if step.strip()
                ] if instructions else []

        return {
            "title": str(title),
            "country": str(
                raw.get("country") or raw.get("cuisine") or "Online recipe"
            ),
            "ingredients": ingredients if isinstance(ingredients, list) else [],
            "instructions": instructions if isinstance(instructions, list) else [],
            "description": str(raw.get("description") or "")
        }

    def focus_search(self):
        self.search_input.setFocus()
        self.search_input.selectAll()

    def show_african_foods(self):
        self.search_input.clear()
        self.show_recipes(RECIPES)
        self.status_label.setText("Explore African recipes.")

    def show_nigerian_jollof(self):
        self.search_input.setText("Nigerian Jollof Rice")
        matches = [
            recipe for recipe in RECIPES
            if recipe["title"] == "Nigerian Jollof Rice"
        ]
        self.show_recipes(matches)

    def show_ghanaian_jollof(self):
        self.search_input.setText("Ghanaian Jollof Rice")
        matches = [
            recipe for recipe in RECIPES
            if recipe["title"] == "Ghanaian Jollof Rice"
        ]
        self.show_recipes(matches)

    def surprise_me(self):
        recipe = random.choice(RECIPES)
        self.show_recipes([recipe])
        self.status_label.setText("Your surprise recipe is ready!")

    def show_favorites(self):
        self.show_recipes(self.favorites)
        self.status_label.setText(
            f"You have {len(self.favorites)} saved favorite(s)."
        )

    def add_favorite(self):
        if not self.current_recipe:
            QMessageBox.information(
                self, "Favorites", "Select a recipe first."
            )
            return

        title = self.current_recipe.get("title")

        if any(item.get("title") == title for item in self.favorites):
            self.status_label.setText("This recipe is already a favorite.")
            return

        self.favorites.append(self.current_recipe.copy())
        self.save_favorites()
        self.status_label.setText(f"Added {title} to favorites!")


